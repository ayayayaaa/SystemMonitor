<Window x:Class="SystemMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SystemMonitor.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="System Monitor" Height="600" Width="900"
        Background="#1E1E2E">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="System Monitor" 
                    FontSize="24" FontWeight="Bold" 
                    Foreground="#CDD6F4"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export Snapshot CSV" Padding="10,5" Margin="0,0,10,0"
                        Background="#A6E3A1" Foreground="#1E1E2E" FontWeight="Bold"
                        Click="ExportSnapshot_Click"/>
                <Button Content="Export Alert History CSV" Padding="10,5"
                        Background="#F38BA8" Foreground="#1E1E2E" FontWeight="Bold"
                        Click="ExportHistory_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- CPU Card -->
            <Border Grid.Column="0" Background="#313244" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="CPU" Foreground="#89B4FA" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Foreground="#CDD6F4" FontSize="28" FontWeight="Bold"
                               Text="{Binding CpuUsage, StringFormat={}{0:F1}%}"/>
                    <ProgressBar Value="{Binding CpuUsage}" Maximum="100" 
                                 Height="6" Margin="0,8,0,0"
                                 Background="#45475A" Foreground="#89B4FA"/>
                </StackPanel>
            </Border>

            <!-- RAM Card -->
            <Border Grid.Column="1" Background="#313244" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="RAM" Foreground="#A6E3A1" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Foreground="#CDD6F4" FontSize="28" FontWeight="Bold"
                               Text="{Binding RamUsage, StringFormat={}{0:F1}%}"/>
                    <TextBlock Foreground="#6C7086" FontSize="11"
                               Text="{Binding RamUsedGB, StringFormat={}{0:F1} GB used}"/>
                    <ProgressBar Value="{Binding RamUsage}" Maximum="100"
                                 Height="6" Margin="0,8,0,0"
                                 Background="#45475A" Foreground="#A6E3A1"/>
                </StackPanel>
            </Border>

            <!-- Download Card -->
            <Border Grid.Column="2" Background="#313244" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="↓ Download" Foreground="#89DCEB" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Foreground="#CDD6F4" FontSize="28" FontWeight="Bold"
                               Text="{Binding DownloadKBps, StringFormat={}{0:F1} KB/s}"/>
                </StackPanel>
            </Border>

            <!-- Upload Card -->
            <Border Grid.Column="3" Background="#313244" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="↑ Upload" Foreground="#F38BA8" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Foreground="#CDD6F4" FontSize="28" FontWeight="Bold"
                               Text="{Binding UploadKBps, StringFormat={}{0:F1} KB/s}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tab Panel -->
        <TabControl Grid.Row="2" Background="#313244" BorderThickness="0">

            <!-- Tab Chart -->
            <TabItem Header="Charts" Foreground="#CDD6F4" Background="#313244">
                <Border Background="#313244" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- CPU Chart -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="CPU Usage (60 detik terakhir)" 
                                    Foreground="#89B4FA" FontWeight="Bold" Margin="0,0,0,5"/>
                            <lvc:CartesianChart 
                                Series="{Binding CpuSeries}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}"
                                Height="150"
                                Background="Transparent"/>
                        </StackPanel>

                        <!-- RAM Chart -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="RAM Usage (60 detik terakhir)" 
                                    Foreground="#A6E3A1" FontWeight="Bold" Margin="0,0,0,5"/>
                            <lvc:CartesianChart 
                                Series="{Binding RamSeries}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}"
                                Height="150"
                                Background="Transparent"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab Disk -->
            <TabItem Header="Disk Usage" Foreground="#CDD6F4" Background="#313244">
                <Border Background="#313244" Padding="15">
                    <ItemsControl ItemsSource="{Binding DiskMetrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock Text="{Binding DriveName}" 
                                                Foreground="#CDD6F4" FontWeight="Bold"/>
                                        <TextBlock DockPanel.Dock="Right" Foreground="#6C7086"
                                                Text="{Binding UsagePercent, StringFormat={}{0:F1}%}"/>
                                    </DockPanel>
                                    <TextBlock Foreground="#6C7086" FontSize="11"
                                            Text="{Binding UsedGB, StringFormat={}{0:F1} GB used}"/>
                                    <ProgressBar Value="{Binding UsagePercent}" Maximum="100"
                                                Height="6" Margin="0,4,0,0"
                                                Background="#45475A" Foreground="#CBA6F7"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </TabItem>

            <!-- Tab Process -->
            <TabItem Header="Processes" Foreground="#CDD6F4" Background="#313244">
                <Border Background="#313244" Padding="15">
                    <DataGrid ItemsSource="{Binding Processes}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            Background="#313244"
                            Foreground="#CDD6F4"
                            BorderThickness="0"
                            RowBackground="#313244"
                            AlternatingRowBackground="#45475A"
                            GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Memory (MB)" 
                                                Binding="{Binding MemoryMB, StringFormat={}{0:F1}}" 
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

        <!-- Tab Alert -->
        <TabItem Header="Alerts" Foreground="#CDD6F4" Background="#313244">
            <Border Background="#313244" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Form tambah rule -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Tambah Alert Rule" Foreground="#CDD6F4" 
                                FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <ComboBox x:Name="MetricCombo" Width="100" Margin="0,0,10,0">
                                <ComboBoxItem Content="CPU" IsSelected="True"/>
                                <ComboBoxItem Content="RAM"/>
                            </ComboBox>
                            <TextBlock Text=">" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="ThresholdBox" Width="60" Margin="0,0,10,0" 
                                    Background="#45475A" Foreground="#CDD6F4" Text="80"/>
                            <TextBlock Text="% selama" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="DurationBox" Width="60" Margin="0,0,10,0"
                                    Background="#45475A" Foreground="#CDD6F4" Text="30"/>
                            <TextBlock Text="detik" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="Tambah" Padding="10,5" Background="#89B4FA" 
                                    Foreground="#1E1E2E" FontWeight="Bold"
                                    Click="AddAlertRule_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Daftar rules aktif -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Rules Aktif" Foreground="#CDD6F4" 
                                FontWeight="Bold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding AlertRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,5">
                                        <Button DockPanel.Dock="Right" Content="Hapus"
                                                Background="#F38BA8" Foreground="#1E1E2E"
                                                Padding="8,3" FontWeight="Bold"
                                                Tag="{Binding}"
                                                Click="DeleteAlertRule_Click"/>
                                        <TextBlock Text="{Binding DisplayName}" 
                                                Foreground="#A6E3A1" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- History -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="History Alert" Foreground="#CDD6F4" 
                                FontWeight="Bold" Margin="0,0,0,8"/>
                        <ListView ItemsSource="{Binding AlertHistories}"
                                Background="#1E1E2E" Foreground="#CDD6F4"
                                BorderThickness="0" MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TriggeredAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                                Foreground="#6C7086" FontSize="11"/>
                                        <TextBlock Text="{Binding Message}" Foreground="#F38BA8"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Border>
        </TabItem>

        </TabControl>
    </Grid>
</Window>